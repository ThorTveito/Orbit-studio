# ── OS junk
.DS_Store
.AppleDouble
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editors / IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ── Claude Code (keep the shared launch config, ignore personal settings)
.claude/*
!.claude/launch.json

# ── Local test material & exports (don't commit personal photos or renders)
_test/
test-photos/
exports/
orbit*.png
orbit*.gif
orbit*.mp4
orbit*.webm

# ── Node (in case a build step / tooling is added later)
node_modules/
dist/
.cache/
.parcel-cache/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Python (the local dev server is `python3 -m http.server`)
__pycache__/
*.py[cod]
.venv/
venv/

# ── Environment / secrets
.env
.env.*
!.env.example

# ── Logs & temp
*.log
*.tmp
.tmp/
